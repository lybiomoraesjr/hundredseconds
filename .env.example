# Database
POSTGRES_DB=hundred_seconds
POSTGRES_USER=hundred_seconds
POSTGRES_PASSWORD=change_me
POSTGRES_HOST_PORT=5433

# API (used when running the Spring Boot app locally against the container)
DATABASE_URL=jdbc:postgresql://localhost:5433/hundred_seconds
DATABASE_USERNAME=hundred_seconds
DATABASE_PASSWORD=change_me

# API HTTP port
SERVER_PORT=8080

# JWT secret (at least 32 characters). Generate one with: openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_secret_with_32_chars_or_more
JWT_EXPIRATION=24h

# Game time zone used by the Day/Week/Year leaderboards
APP_TIME_ZONE=America/Sao_Paulo

# Web app origin allowed by CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173
